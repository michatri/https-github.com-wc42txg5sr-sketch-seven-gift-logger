# คัดลอกเป็น camera.env แล้วแก้ค่าให้ตรงกล้องจริง
# cp config/camera.example.env config/camera.env

CAMERA_IP=192.168.1.64
CAMERA_USER=admin
CAMERA_PASS=YourPasswordHere

# 101 = main stream (คมกว่า), 102 = sub stream (เบาเครื่องกว่า เหมาะทดสอบ AI)
CAMERA_CHANNEL=101

# สร้างเองได้จากค่าด้านบน หรือใส่ RTSP ตรง ๆ
# RTSP_URL=rtsp://admin:YourPasswordHere@192.168.1.64:554/Streaming/Channels/101

# ความมั่นใจขั้นต่ำตอนจับคู่ใบหน้า (0.35–0.55 ลองปรับ)
MATCH_THRESHOLD=0.42

# กันลงเวลาซ้ำภายในกี่วินาที
COOLDOWN_SECONDS=120
